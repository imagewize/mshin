[Unit]
Description=Avendesora Node: MCP Server for Kali Tools
After=network.target

[Service]
User=avendesora
WorkingDirectory=/opt/avendesora/servers/src/kali
ExecStart=/usr/bin/node index.js --tools nmap,metasploit,searchsploit,nikto,whois,tshark
Restart=always
RestartSec=5s
Environment=NODE_ENV=production

# Security settings
# NoNewPrivileges is deliberately NOT set. tools.js runs each binary as
# `sudo -n <bin>` whenever the server is not root (see the NOPASSWD allowlist in
# /etc/sudoers.d/avendesora), and NoNewPrivileges=true blocks exactly that:
# every tool call fails with "sudo: The "no new privileges" flag is set".
# The sudoers allowlist is what constrains this service, not this flag.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/avendesora /home/avendesora

[Install]
WantedBy=multi-user.target
