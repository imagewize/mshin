[Unit]
Description=Machin Shin Node: MCP Server for Kali Tools
After=network.target

[Service]
User=mshin
WorkingDirectory=/opt/mshin/servers/src/kali
ExecStart=/usr/bin/node index.js --tools nmap,metasploit,searchsploit,nikto,whois,tshark,hydra,sqlmap,gobuster,masscan,dirb,arping,dnsenum,enum4linux,ffuf,john
Restart=always
RestartSec=5s
Environment=NODE_ENV=production
# Require bearer-token authentication on /mcp: without it, any host on the
# LAN can drive the Node's tools. Set a random token (openssl rand -hex 32)
# and give the same value to the Core (CLI --token flag or MSHIN_NODE_TOKEN).
# scripts/setup_mcp_server.sh injects this line from /etc/mshin-node-token.
# Leave commented to keep the legacy open behavior.
# Environment=MSHIN_NODE_TOKEN=

# Security settings
# NoNewPrivileges is deliberately NOT set. tools.js runs most binaries as
# `sudo -n <bin>` whenever the server is not root (see the NOPASSWD allowlist in
# /etc/sudoers.d/mshin), and NoNewPrivileges=true blocks exactly that:
# every tool call fails with "sudo: The "no new privileges" flag is set".
# tshark is the exception: it runs as the service user because reading PCAP
# files as root triggers Wireshark's file-owner check. The sudoers allowlist is
# what constrains the remaining tools, not this flag.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/mshin /home/mshin

[Install]
WantedBy=multi-user.target
