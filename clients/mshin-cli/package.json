{
  "name": "avendesora-cli",
  "version": "0.2.0",
  "description": "Interactive CLI harness that connects Ollama to the Avendesora Kali MCP server.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "avendesora": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "check": "node --check index.js && node --check agent.js",
    "test": "node --check index.js && node --check agent.js && node --test --test-timeout=15000"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
